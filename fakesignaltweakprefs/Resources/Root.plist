			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.yourname.fakesignaltweak/preferences.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Off (default for now) leaves just the carrier name. The "9G" badge is parked separately from the Carrier Name replacement, which is the part being debugged right now — you can just put "9G" in the carrier name itself instead, like "Whiz Wireless 9G ".</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Signal</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yourname.fakesignaltweak</string>

			<string>NetworkTypeLabel</string>
			<key>label</key>
			<string>Network Type</string>
			<key>default</key>
			<string>9G</string>
			<key>autocapitalizationType</key>
			<string>AllCharacters</string>
			<key>autocorrectionType</key>
			<string>No</string>
			<key>PostNotification</key>
			<string>com.yourname.fakesignaltweak/preferences.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yourname.fakesignaltweak</string>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Whiz Wireless</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Cosmetic status bar override. Toggling Enabled takes effect immediately; other fields refresh on the next status bar update, or force it with a respring.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.yourname.fakesignaltweak</string>
			<key>key</key>
			<string>Enabled</string>
			<key>label</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.yourname.fakesignaltweak/preferences.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Status Bar Text</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>defaults</key>
			<string>com.yourname.fakesignaltweak</string>
			<key>key</key>
			<string>CarrierName</string>
			<key>label</key>
			<string>Carrier Name</string>
			<key>default</key>
			<string>Whiz Wireless 9G </string>
			<key>autocapitalizationType</key>
			<string>Words</string>
			<key>autocorrectionType</key>
			<string>No</string>
			<key>PostNotification</key>
			<string>com.yourname.fakesignaltweak/preferences.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>defaults</key>
			<string>com.yourname.fakesignaltweak</string>
